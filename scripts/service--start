#!/usr/bin/env bash
set -euo pipefail

SERVICE_NAME="civil-command.service"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

UID_NUM="$(id -u)"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/${UID_NUM}}"
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -S "${XDG_RUNTIME_DIR}/bus" ]; then
 export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"
fi

UNIT_PATH="${XDG_CONFIG_HOME:-${HOME}/.config}/systemd/user/${SERVICE_NAME}"
if [ ! -f "${UNIT_PATH}" ]; then
 echo "Error: ${SERVICE_NAME} is not installed (${UNIT_PATH} missing). Run ./scripts/service--install first." >&2
 exit 1
fi

CURRENT_MAIN_PID="$(systemctl --user show -p MainPID --value "${SERVICE_NAME}" 2>/dev/null || echo 0)"
UNMANAGED_PIDS=()
for proc_dir in /proc/[0-9]*; do
 pid="${proc_dir#/proc/}"
 [ "${pid}" = "$$" ] && continue
 [ "${pid}" = "${CURRENT_MAIN_PID}" ] && continue
 proc_cwd="$(readlink "${proc_dir}/cwd" 2>/dev/null || true)"
 [ "${proc_cwd}" = "${REPO_DIR}" ] || continue
 cmdline="$(tr '\0' ' ' < "${proc_dir}/cmdline" 2>/dev/null || true)"
 case " ${cmdline} " in
  *node*" start "*|*node*" ./start "*|*node*"/start "*)
   UNMANAGED_PIDS+=("${pid}")
   ;;
 esac
done

if [ "${#UNMANAGED_PIDS[@]}" -gt 0 ]; then
 echo "Stopping unmanaged civil-command process(es) in ${REPO_DIR}: ${UNMANAGED_PIDS[*]}"
 kill "${UNMANAGED_PIDS[@]}" 2>/dev/null || true
 sleep 0.4
fi

systemctl --user start "${SERVICE_NAME}"
sleep 0.4
if ! systemctl --user is-active --quiet "${SERVICE_NAME}"; then
 echo "Error: ${SERVICE_NAME} failed to start. Recent logs:" >&2
 journalctl --user -u "${SERVICE_NAME}" -n 30 --no-pager >&2 || true
 exit 1
fi

systemctl --user status --no-pager --lines=5 "${SERVICE_NAME}"
