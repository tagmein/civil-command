#!/usr/bin/env node
const http = require('http')
const fs = require('fs')
const path = require('path')

const rootDir = path.resolve('.')
const indexPath = path.join(rootDir, 'index.html')

// Optional startup flag; CC_KV_CHUNK_BYTES (or browser global) works too.
const kvChunkArg = process.argv.find(arg => arg.startsWith('--kv-chunk-bytes='))
if (kvChunkArg) process.env.CC_KV_CHUNK_BYTES = kvChunkArg.slice('--kv-chunk-bytes='.length)

const fsApiPromise = import('./fs-api.mjs')
const httpSecurityPromise = import('./http-security.mjs')
const deployApiPath = path.join(rootDir, 'deploy-api.mjs')
let sharedTerminalManager = null
let cachedDeployMtimeMs = -1
let cachedDeployApiPromise = null

async function getDeployApi() {
 const stat = await fs.promises.stat(deployApiPath)
 if (!cachedDeployApiPromise || stat.mtimeMs !== cachedDeployMtimeMs) {
  cachedDeployMtimeMs = stat.mtimeMs
  cachedDeployApiPromise = import(`./deploy-api.mjs?v=${stat.mtimeMs}`)
   .then(mod => {
    if (!sharedTerminalManager) {
     sharedTerminalManager = mod.defaultTerminalManager
    }
    return mod
   })
   .catch(err => {
    cachedDeployMtimeMs = -1
    cachedDeployApiPromise = null
    throw err
   })
 }
 return cachedDeployApiPromise
}

const agentApiPromise = import('./agent-api.mjs')
const dataProxyPromise = import('./data-proxy.mjs').then(({
 createDataProxyHandler,
 createFileBackedServerSecretStore,
}) => {
 const secretStore = createFileBackedServerSecretStore()
 return createDataProxyHandler({
  backendBaseUrl: 'http://localhost:3333/?mode=disk',
  secretStore,
 })
})

const mimeTypes = {
 '.html': 'text/html; charset=utf-8',
 '.js': 'text/javascript; charset=utf-8',
 '.mjs': 'text/javascript; charset=utf-8',
 '.css': 'text/css; charset=utf-8',
 '.json': 'application/json; charset=utf-8',
 '.webmanifest': 'application/manifest+json; charset=utf-8',
 '.fs': 'text/plain; charset=utf-8',
 '.svg': 'image/svg+xml',
 '.png': 'image/png',
 '.jpg': 'image/jpeg',
 '.ico': 'image/x-icon',
 '.wasm': 'application/wasm',
}

function serveFile(filePath, res) {
 const ext = path.extname(filePath).toLowerCase()
 const contentType = mimeTypes[ext] || 'application/octet-stream'
 const headers = { 'Content-Type': contentType }
 if (path.basename(filePath) === 'sw.js') {
  headers['Cache-Control'] = 'no-cache'
 }

 fs.createReadStream(filePath)
 .on('open', () => {
  res.writeHead(200, headers)
 })
 .on('error', () => {
  if (!res.headersSent) {
   res.writeHead(404, { 'Content-Type': 'text/plain; charset=utf-8' })
  }
  res.end('Not found')
 })
 .pipe(res)
}

function handleIncomingRequest(req, res) {
 const reqPathname = (req.url || '/').split('?')[0]
 if (reqPathname === '/api/fs' || reqPathname.startsWith('/api/fs/')) {
  return Promise.all([fsApiPromise, dataProxyPromise])
   .then(([{ handleFsApiRequest }, { secretStore }]) => handleFsApiRequest(req, res, { secretStore }))
   .catch(err => {
    if (!res.headersSent) {
     res.writeHead(500, { 'Content-Type': 'application/json; charset=utf-8' })
    }
    res.end(JSON.stringify({ ok: false, error: err && err.message ? err.message : 'Filesystem error' }))
   })
 }

 if (reqPathname === '/api/deploy' || reqPathname.startsWith('/api/deploy/')) {
  return Promise.all([getDeployApi(), dataProxyPromise])
   .then(([{ handleDeployApiRequest }, { secretStore }]) =>
    handleDeployApiRequest(req, res, { terminalManager: sharedTerminalManager, secretStore })
   )
   .catch(err => {
    if (!res.headersSent) {
     res.writeHead(500, { 'Content-Type': 'application/json; charset=utf-8' })
    }
    res.end(JSON.stringify({ ok: false, error: err && err.message ? err.message : 'Deploy API error' }))
   })
 }

 if (reqPathname === '/api/mcp' || reqPathname === '/api/agent' || reqPathname.startsWith('/api/agent/')) {
  return Promise.all([agentApiPromise, dataProxyPromise])
   .then(([{ handleAgentApiRequest }, { secretStore, createAuthorizedRootKv }]) =>
    handleAgentApiRequest(req, res, { secretStore, createAuthorizedRootKv })
   )
   .catch(err => {
    if (!res.headersSent) {
     res.writeHead(500, { 'Content-Type': 'application/json; charset=utf-8' })
    }
    res.end(JSON.stringify({ ok: false, error: err && err.message ? err.message : 'Agent API error' }))
   })
 }

 if (reqPathname === '/api/vault' || reqPathname.startsWith('/api/vault/')) {
  return dataProxyPromise
   .then(({ handleVaultApiRequest }) => handleVaultApiRequest(req, res))
   .catch(err => {
    if (!res.headersSent) {
     res.writeHead(500, { 'Content-Type': 'application/json; charset=utf-8' })
    }
    res.end(JSON.stringify({ ok: false, error: err && err.message ? err.message : 'Vault API error' }))
   })
 }

 if (reqPathname === '/api/data' || reqPathname.startsWith('/api/data/')) {
  return dataProxyPromise
   .then(({ handleDataProxyRequest }) => handleDataProxyRequest(req, res))
   .catch(err => {
    if (!res.headersSent) {
     res.writeHead(502, { 'Content-Type': 'text/plain; charset=utf-8' })
    }
    res.end('Bad gateway: ' + (err && err.message ? err.message : 'Proxy error'))
   })
 }

 const reqPath = (req.url === '/' ? '/index.html' : req.url.split('?')[0])
 const filePath = path.resolve(rootDir, '.' + reqPath)

 const vaultKeyFilePath = process.env.CC_VAULT_KEY_FILE
  ? path.resolve(process.env.CC_VAULT_KEY_FILE)
  : null
 if (
  (!filePath.startsWith(rootDir + path.sep) && filePath !== rootDir) ||
  (vaultKeyFilePath && filePath === vaultKeyFilePath) ||
  reqPath.split('/').some(seg => seg.startsWith('.') && seg !== '.')
 ) {
  res.writeHead(403)
  return res.end('Forbidden')
 }

 fs.stat(filePath, (err, stat) => {
  if (!err && stat.isFile()) {
   return serveFile(filePath, res)
  }
  // SPA fallback for client-side routes (e.g., /dashboard/settings)
  serveFile(indexPath, res)
 })
}

const server = http.createServer((req, res) => {
 httpSecurityPromise
  .then(({ isAllowedLocalHost }) => {
   if (!isAllowedLocalHost(req, { requireHost: true })) {
    const reqPathname = (req.url || '/').split('?')[0]
    if (reqPathname === '/api' || reqPathname.startsWith('/api/')) {
     res.writeHead(403, { 'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'no-store' })
     res.end(JSON.stringify({ ok: false, error: 'Forbidden Host header' }))
    }
    else {
     res.writeHead(403, { 'Content-Type': 'text/plain; charset=utf-8' })
     res.end('Forbidden')
    }
    return
   }
   handleIncomingRequest(req, res)
  })
  .catch(err => {
   if (!res.headersSent) {
    res.writeHead(500, { 'Content-Type': 'text/plain; charset=utf-8' })
   }
   res.end('Internal server error: ' + (err && err.message ? err.message : 'Security error'))
  })
})

server.on('upgrade', (req, socket, head) => {
 const reqPathname = (req.url || '/').split('?')[0]
 if (reqPathname === '/api/deploy/terminal/ws') {
  Promise.all([httpSecurityPromise, getDeployApi()])
   .then(([{ isAllowedLocalHost, isAllowedLocalOrigin }, { handleDeployUpgrade }]) => {
    if (!isAllowedLocalHost(req, { requireHost: true }) || !isAllowedLocalOrigin(req, { requireHost: true })) {
     if (!socket.destroyed) {
      socket.write('HTTP/1.1 403 Forbidden\r\nConnection: close\r\n\r\n')
      socket.destroy()
     }
     return
    }
    handleDeployUpgrade(req, socket, head, { terminalManager: sharedTerminalManager, requireHost: true })
   })
   .catch(() => {
    if (!socket.destroyed) {
     socket.destroy()
    }
   })
  return
 }
 socket.destroy()
})

server.listen(8080, () => {
 console.log('Serving on http://localhost:8080')
})
